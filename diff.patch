new file mode 100644
index 0000000..fe5a173
--- /dev/null
+++ b/src/hypervisor_bootloader/build.rs
@@ -0,0 +1,29 @@
+use std::env;
+use std::path::PathBuf;
+use std::process::Command;
+
+const QEMU_DTS_NAME: &str = "virt-qemu.dts";
+const BF2_DTS_NAME: &str = "virt-bf2.dts";
+
+fn main() {
+    let dts_name = if env::var_os("CARGO_FEATURE_LWIE_BF2").is_some() {
+        BF2_DTS_NAME
+    } else {
+        QEMU_DTS_NAME
+    };
+    let source_dts = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../dts")
+        .join(dts_name);
+    let dest_dtb =
+        PathBuf::from(env::var_os("OUT_DIR").expect("OUT_DIR is not set")).join("virt.dtb");
+
+    println!("cargo:rerun-if-changed={}", source_dts.display());
+
+    let status = Command::new("dtc")
+        .args(["-I", "dts", "-O", "dtb", "-o"])
+        .arg(&dest_dtb)
+        .arg(&source_dts)
+        .status()
+        .expect("Failed to run dtc");
+    assert!(status.success(), "dtc command failed with status: {status}");
+}
