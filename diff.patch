new file mode 100644
index 0000000..b2e50de
--- /dev/null
+++ b/src/hypervisor_kernel/src/drivers/ivshmem.rs
@@ -0,0 +1,52 @@
+//! QEMU ivshmem BAR setup for the virtual SmartNIC transport.
+
+use core::ptr::{read_volatile, write_volatile};
+
+use crate::pci::get_ecam_target_address;
+
+pub const VENDOR_ID: u16 = 0x1AF4;
+pub const DEVICE_ID: u16 = 0x1110;
+
+const PCI_COMMAND: usize = 0x04;
+const PCI_COMMAND_MEMORY: u16 = 1 << 1;
+const PCI_BAR2: usize = 0x18;
+const PCI_BAR3: usize = 0x1C;
+
+/// Assign BAR2 after UEFI has exited.  QEMU's ivshmem-plain exposes the shared
+/// RAM through this 64-bit prefetchable BAR, but AArch64 firmware does not
+/// allocate it consistently.
+pub fn setup_device(ecam_address: usize, bus: u8, device: u8, function: u8) {
+    let config = get_ecam_target_address(ecam_address, bus, device, function);
+    let command = unsafe { read_volatile((config + PCI_COMMAND) as *const u16) };
+    let original_bar2 = unsafe { read_volatile((config + PCI_BAR2) as *const u32) };
+    let bar_flags = original_bar2 & 0xF;
+
+    assert_eq!(bar_flags & 0x6, 0x4, "ivshmem BAR2 must be 64-bit");
+    unsafe {
+        write_volatile(
+            (config + PCI_COMMAND) as *mut u16,
+            command & !PCI_COMMAND_MEMORY,
+        );
+        write_volatile(
+            (config + PCI_BAR2) as *mut u32,
+            common::SNIC_SHARED_MEMORY_BASE as u32 | bar_flags,
+        );
+        write_volatile((config + PCI_BAR3) as *mut u32, 0);
+        write_volatile(
+            (config + PCI_COMMAND) as *mut u16,
+            command | PCI_COMMAND_MEMORY,
+        );
+    }
+
+    let programmed_bar2 = unsafe { read_volatile((config + PCI_BAR2) as *const u32) };
+    assert_eq!(
+        programmed_bar2 & !0xF,
+        common::SNIC_SHARED_MEMORY_BASE as u32,
+        "failed to assign the ivshmem BAR"
+    );
+    println!(
+        "ivshmem BAR2: {:#X} ({} bytes)",
+        common::SNIC_SHARED_MEMORY_BASE,
+        common::SNIC_SHARED_MEMORY_SIZE
+    );
+}
