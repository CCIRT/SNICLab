diff --git a/src/common/build.rs b/src/common/build.rs
index 6c53fa7..be2cfa3 100644
--- a/src/common/build.rs
+++ b/src/common/build.rs
@@ -22,17 +22,10 @@ fn set_environments() {
         }
     }
 
-    if let Ok(output) = Command::new("git")
-        .arg("rev-parse")
-        .arg("HEAD")
-        .stdin(Stdio::null())
-        .stderr(Stdio::null())
-        .output()
-    {
-        if output.status.success() {
-            if let Ok(git_hash) = std::str::from_utf8(output.stdout.as_slice()) {
-                println!("cargo:rustc-env=PROJECT_HASH={git_hash}");
-            }
-        }
+    // This prototype deliberately performs no VCS commands during a build.
+    // A caller that needs an external build identifier may provide one.
+    println!("cargo:rerun-if-env-changed=VSNIC_BUILD_ID");
+    if let Ok(build_id) = std::env::var("VSNIC_BUILD_ID") {
+        println!("cargo:rustc-env=PROJECT_HASH={build_id}");
     }
 }
diff --git a/src/common/src/lib.rs b/src/common/src/lib.rs
index 389031d..3c50e26 100644
--- a/src/common/src/lib.rs
+++ b/src/common/src/lib.rs
@@ -64,6 +64,24 @@ pub const STAGE_2_PAGE_MASK: usize = !(STAGE_2_PAGE_SIZE - 1);
 /// STACK_SIZE = STACK_PAGES << PAGE_SHIFT = STACK_PAGES * PAGE_SIZE
 pub const STACK_PAGES: usize = 16;
 
+/// Fixed PCI BAR address used by the QEMU ivshmem transport.
+pub const SNIC_SHARED_MEMORY_BASE: usize = 0x3E00_0000;
+/// Size of the shared ivshmem object passed to QEMU.
+pub const SNIC_SHARED_MEMORY_SIZE: usize = 8 * 1024 * 1024;
+/// Shared ABI header occupies the first page.
+pub const SNIC_SHARED_HEADER_SIZE: usize = 0x1000;
+/// Page-aligned size reserved for one SPSC ring.
+pub const SNIC_SHARED_RING_STRIDE: usize = 0x101000;
+/// Two directional rings are assigned to each tenant.
+pub const SNIC_SHARED_RINGS_PER_TENANT: usize = 2;
+
+/// VirtIO console transports reserved for the two QEMU AP guests.
+///
+/// The addresses and interrupt IDs correspond to `virtio-mmio-bus.31` and
+/// `virtio-mmio-bus.23` on QEMU's `virt` machine.
+pub const QEMU_VIRTIO_CONSOLE_DEVICES: [(usize, u32); 2] =
+    [(0x0A00_3E00, 32 + 0x2F), (0x0A00_2E00, 32 + 0x27)];
+
 pub type HypervisorKernelMainType = fn(&mut SystemInformation);
 
 pub type GeneralPurposeRegisters = [u64; 32];
@@ -120,7 +138,7 @@ pub struct SystemInformation {
 
 /// For passing Linux Boot Information
 #[repr(C)]
-#[derive(Clone)]
+#[derive(Clone, Debug)]
 pub struct LinuxBootInformation {
     pub ram_physical_address: usize,
     pub ram_size: usize,
@@ -128,4 +146,6 @@ pub struct LinuxBootInformation {
     pub dtb_address: usize,
     pub mpidr_el1: u64,
     pub virtio_int_id: u32,
+    pub virtio_console_base_address: usize,
+    pub virtio_console_int_id: u32,
 }
